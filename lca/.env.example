# Brightway data directory (git-ignored). Relative paths are relative to this folder (lca/)
BRIGHTWAY2_DIR=brightway

# ecoinvent credentials (used for the one-time database download)
ECOINVENT_USERNAME=your_ecoinvent_username
ECOINVENT_PASSWORD=your_ecoinvent_password

# regioinvent trade database (git-ignored); see the README for the download command
TRADE_DATABASE_PATH=trade_data.db
